<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled -->
    <item android:alpha="0.12" android:color="?android:attr/textColorPrimary" android:state_enabled="false"/>

    <!-- Focused -->
    <item android:color="@color/primary" android:state_focused="true"/>

    <!-- Selected: no stroke (filled tonal chip) -->
    <item android:color="@android:color/transparent" android:state_selected="true"/>
    <item android:color="@android:color/transparent" android:state_checked="true"/>

    <!-- Idle: neutral outline, not Monet accent -->
    <item android:color="@color/hairline"/>
</selector>
