<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_folder_row"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/home_folder_icon_bg">

        <ImageView
            android:id="@+id/home_folder_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_doc_folder" />
    </FrameLayout>

    <TextView
        android:id="@+id/home_folder_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/home_text_primary"
        android:textSize="16sp" />
</LinearLayout>
